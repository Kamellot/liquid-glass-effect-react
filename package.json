{
  "name": "liquid-glass-effect-react",
  "version": "0.1.2",
  "description": "SSR-safe Liquid Glass React UI primitive powered by a 1/4-quadrant SDF WebGL/Canvas refraction engine and pure CSS optics.",
  "homepage": "https://github.com/Kamellot/liquid-glass-effect-react#readme",
  "bugs": {
    "url": "https://github.com/Kamellot/liquid-glass-effect-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kamellot/liquid-glass-effect-react.git"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "webgl",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib && npm test",
    "preview": "vite preview",
    "test": "esbuild tests/perf-monitor.test.ts tests/liquid-glass-config.test.ts --bundle --platform=node --format=cjs --loader:.css=empty --external:react --external:react-dom --external:react-dom/server --outdir=dist/.test --out-extension:.js=.cjs && node --test dist/.test/*.cjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
